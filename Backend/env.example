# Atlas connection string. If this is missing or the cluster cannot be reached,
# the app still starts and keeps data in a temporary in-memory database.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kitechin
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
PORT=8080
ADMIN_SIGNUP_CODE=choose-a-secret-invite-code
